def send_motor_command(cmd: str):
    """Send L, R, or C to MegaPi via USB serial."""
    if mega_board is not None and mega_board.is_open:
        mega_board.write(f"{cmd}\n".encode("utf-8"))


# =============================================================================
# 🎨 CAMERA HELPERS
# =============================================================================
class SmoothedBox:
    """Exponential smoothing on bounding-box coordinates."""
    def __init__(self, alpha=0.3):
        self.alpha     = alpha
        self.prev_box  = None

    def update(self, new_box):
        if self.prev_box is None:
            self.prev_box = new_box
            return new_box
        x, y, w, h     = new_box
        px, py, pw, ph  = self.prev_box
        smoothed = (
            int(self.alpha * x  + (1 - self.alpha) * px),
            int(self.alpha * y  + (1 - self.alpha) * py),
            int(self.alpha * w  + (1 - self.alpha) * pw),
            int(self.alpha * h  + (1 - self.alpha) * ph),
        )
        self.prev_box = smoothed
        return smoothed


def draw_hitbox(frame, x, y, w, h, label="TARGET"):
    color      = (0, 255, 0)
    corner_len = max(20, w // 6)
    th         = 2

    # Corners
    cv2.line(frame, (x,     y),     (x + corner_len, y),              color, th)
    cv2.line(frame, (x,     y),     (x,     y + corner_len),          color, th)
    cv2.line(frame, (x + w, y),     (x + w - corner_len, y),          color, th)
    cv2.line(frame, (x + w, y),     (x + w, y + corner_len),          color, th)
    cv2.line(frame, (x,     y + h), (x + corner_len, y + h),          color, th)
    cv2.line(frame, (x,     y + h), (x,     y + h - corner_len),      color, th)
    cv2.line(frame, (x + w, y + h), (x + w - corner_len, y + h),      color, th)
    cv2.line(frame, (x + w, y + h), (x + w, y + h - corner_len),      color, th)

    # Crosshair
    cx, cy = x + w // 2, y + h // 2
    cv2.line(frame, (cx - 15, cy), (cx + 15, cy), color, 1)
    cv2.line(frame, (cx, cy - 15), (cx, cy + 15), color, 1)
    cv2.circle(frame, (cx, cy), 6, color, 1)

    cv2.putText(frame, f"[ {label} ]",         (x, y - 8),
                cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 1)
    cv2.putText(frame, f"({cx},{cy}) {w}x{h}", (x, y + h + 18),
                cv2.FONT_HERSHEY_SIMPLEX, 0.45, color, 1)


# =============================================================================
# 🧠 VENEZUELA AMBASSADOR BOT
# =============================================================================
_WAKE_RE = re.compile(r'\b(orbi\w{0,4}|ori|odin)\b', re.IGNORECASE)


import difflib

def es_wake_word(texto: str) -> bool:
    """True if text contains the activation word (Orbit and variants, including ori/odin)."""
    if not texto:
        return False

    # 1. Regex — covers orbit/orbi/orbita, ori, odin
    if bool(_WAKE_RE.search(texto)):
        return True

    # 2. Fuzzy match for common mis-transcriptions
    trigger_words = ["orbit", "orb", "órbita", "orbe", "orbo", "corbi", "porbi",
                     "ori", "odin", "orín"]
    words_spoken = texto.lower().split()
    for word in words_spoken:
        if difflib.get_close_matches(word, trigger_words, n=1, cutoff=0.75):
            return True

    return False


class Embajador:
    """Venezuela ambassador — same logic as venezuela_bot.py."""

    def __init__(self):
        self.cfg         = cargar_config()
        self.sesion      = requests.Session()
        self.web         = BusquedaWeb()
        self.hay_internet = False
        self.ya_saludo   = False

        self.voz   = Voz(velocidad=0.85)
        self.oidos = Escuchar()
        self.agente = AgenteVenezuela(self.cfg)

        self._detectar_internet()

    @property
    def modelo(self):    return self.cfg.modelo

    @property
    def proveedor(self): return self.cfg.proveedor

    def reiniciar(self):
        self.ya_saludo = False
        self.agente.reiniciar_historial()

    def _detectar_internet(self):
        print("🔍 Detectando internet...")
        self.hay_internet = self.web.hay_internet()
        print("✅ Internet disponible\n" if self.hay_internet else "⚠️ Sin internet\n")

    def consultar_ia(self, mensaje):
        return self.agente.responder(mensaje)

    def responder(self, mensaje):
        msg = mensaje.lower().strip()

        if any(p in msg for p in ["hola", "buenos", "buenas", "qué tal", "saludos"]):
            if not self.ya_saludo:
                self.ya_saludo = True
                return random.choice([
                    "¡Hola explorador! ¿Qué quieres saber de Venezuela hoy?",
                    "¡Hola aventurero! Me alegra que estés aquí. ¿Sobre qué hablamos?",
                    "¡Ey! Qué bueno verte. ¿Qué quieres descubrir hoy?",
                    "¡Hola! Listo para explorar Venezuela. ¿Por dónde empezamos?",
                ])

        if any(p in msg for p in ["chao", "adiós", "adios", "hasta luego", "bye"]):
            return random.choice([
                "¡Chao! Fue hermoso hablar contigo.",
                "¡Hasta luego! Te espero de vuelta.",
                "¡Chao! Vuelve cuando quieras.",
            ])

        if "gracias" in msg:
            return random.choice([
                "¡De nada! Para eso estoy aquí.",
                "¡Un placer! Aquí estoy siempre que necesites.",
            ])

        palabras = msg.split()
        if palabras and palabras[0] in ("no", "nel", "nah", "nop") and len(palabras) <= 3:
            return random.choice([
                "¡Ok! Si tienes alguna otra pregunta, solo di 'Orbit' y aquí estaré.",
                "¡Entendido! Cuando quieras saber algo, llámame diciendo 'Orbit'.",
                "¡Perfecto! Recuerda que solo tienes que decir 'Orbit' para llamarme.",
            ])

        # ── Custom questions (offline keyword match) ──────────────────
        resp_custom = responder_offline(mensaje)
        if resp_custom:
            return resp_custom

        resp_ia = self.consultar_ia(mensaje)
        if resp_ia == ERROR_OLLAMA:
            return (
                "¡Ups! Mi cerebro está descansando. Pero pregúntame sobre: "
                "¿la arepa? ¿el Salto Ángel? ¿el joropo? ¿las hallacas? "
                "¿Simón Bolívar? ¿la Navidad? ¿los llanos?"
            )
        if resp_ia == ERROR_MODELO:
            return (
                f"⚠️ El modelo '{self.cfg.modelo}' no está en Ollama. "
                f"Ejecuta: ollama pull {self.cfg.modelo}"
            )
        if resp_ia == ERROR_TIMEOUT:
            return random.choice([
                "Perdón, me tardé un poquito. ¿Puedes repetirme lo que dijiste?",
                "Ay, se me fue la mente. ¿Me repites eso?",
                "¡Ups! No te escuché bien. ¿Puedes decirlo de nuevo?",
            ])
        if resp_ia:
            return resp_ia

        return (
            "¡Ay! No sé sobre eso. Pero puedo contarte de: "
            "arepa, hallaca, tequeño, salto angel, bolívar, joropo, gaita, "
            "navidad, carnaval, llanos, playa. ¡Pregúntame!"
        )


# =============================================================================
# 🎤 INTERRUPT WATCHER  (secondary thread, runs while bot is talking)
# =============================================================================
def _vigilar_interrupcion(bot, evento_interrupcion, evento_parar):
    """Listens for wake word WHILE the bot speaks."""
    import speech_recognition as sr

    while bot.voz.hablando and not evento_parar.is_set():
        adquirido = bot.oidos._mic_lock.acquire(blocking=False)
        if not adquirido:
            time.sleep(0.05)
            continue
        try:
            with bot.oidos.microfono as fuente:
                try:
                    audio = bot.oidos.reconocedor.listen(
                        fuente, timeout=0.5, phrase_time_limit=1.2
                    )
                    try:
                        texto = bot.oidos.reconocedor.recognize_google(
                            audio, language="es-ES"
                        )
                        if es_wake_word(texto):
                            evento_interrupcion.set()
                            bot.voz.detener()
                            break
                    except sr.UnknownValueError:
                        pass
                    except sr.RequestError:
                        pass
                except sr.WaitTimeoutError:
                    pass
        except Exception:
            pass
        finally:
            bot.oidos._mic_lock.release()


# =============================================================================
# 🤖 BOT THREAD  —  runs the conversation loop in background
# =============================================================================
def bot_loop(bot, bot_state: dict, state_lock: threading.Lock):
    """
    Conversation loop. Fixed phrases (saludos, interrupciones, despedidas)
    are played from pre-generated MP3s via AudioCache — instant, no TTS delay.
    LLM responses still go through TTS as usual.
    """
    cache = AudioCache(bot.voz)

    DESPEDIDAS = [
        "¡Chao! Fue hermoso hablar contigo.",
        "¡Hasta luego! Te espero de vuelta.",
        "¡Chao! Vuelve cuando quieras.",
    ]
    SALUDOS_INICIO = [
        "¡Hola explorador! ¿Qué quieres saber de Venezuela hoy?",
        "¡Hola aventurero! Me alegra que estés aquí. ¿Empezamos?",
        "¡Ey! Qué bueno verte. ¿Qué quieres descubrir hoy?",
        "¡Hola! Listo para explorar Venezuela. ¿Por dónde empezamos?",
    ]
    FRASES_INTERRUPCION = [
        "¡Dime!",
        "¡Aquí estoy!",
        "¿Sí?",
        "¡Dime qué quieres saber!",
    ]

    dormido = True
    print("\n" + "=" * 60)
    print("🤖 BOT THREAD READY — Di 'ORBIT' para activar")
    print("=" * 60 + "\n")

    def _set_talking(v: bool):
        with state_lock:
            bot_state["talking"] = v

    def _set_active(v: bool):
        with state_lock:
            bot_state["active"] = v

    while True:
        try:
            # ── DORMIDO ──────────────────────────────────────────────────────
            if dormido:
                _set_active(False)

                # ── Guard: don't listen while bot is speaking ─────────────
                with state_lock:
                    currently_talking = bot_state["talking"]
                    face_wake = bot_state.get("face_wake", False)
                if currently_talking:
                    time.sleep(0.1)
                    continue

                # ── Face-activation trigger (set by camera loop) ──────────
                if face_wake:
                    with state_lock:
                        bot_state["face_wake"] = False
                    print("🟢 Orbit activado por cara detectada")
                    bot.reiniciar()
                    _set_active(True)
                    _set_talking(True)
                    key = cache.play_random_and_wait("saludo", 4, SALUDOS_INICIO)
                    print(f"🤖 [{key}]\n")
                    _set_talking(False)
                    bot.ya_saludo = True
                    dormido = False
                    continue

                _set_talking(False)
                # Use timeout=1 so we poll face_wake every second
                texto = bot.oidos.escuchar(timeout=1, frase_max=4)
                if not texto or texto == "__TIMEOUT__":
                    continue
                if es_wake_word(texto):
                    print(f"🟢 Orbit activado: '{texto}'")
                    bot.reiniciar()
                    _set_active(True)
                    _set_talking(True)
                    key = cache.play_random_and_wait("saludo", 4, SALUDOS_INICIO)
                    print(f"🤖 [{key}]\n")
                    _set_talking(False)
                    bot.ya_saludo = True
                    dormido = False
                continue

            # ── ACTIVO ───────────────────────────────────────────────────────
            _set_active(True)
            texto = bot.oidos.escuchar(timeout=8, frase_max=6)

            # 8 s silence → goodbye and sleep
            if texto == "__TIMEOUT__":
                _set_talking(True)
                key = cache.play_random_and_wait("despedida", 3, DESPEDIDAS)
                print(f"\n🤖 [{key}]\n")
                _set_talking(False)
                print("💤 Volviendo a dormir... Di 'Orbit' cuando quieras.\n")
                dormido = True
                continue

            if not texto:
                continue

            texto_lower = texto.lower().strip()

            # Wake word while active → acknowledge
            # Guard: only trigger if utterance is short (≤ 3 words).
            # Long sentences occasionally contain sounds like "orbit" — we don't
            # want the bot to interrupt itself for those.
            if es_wake_word(texto_lower) and len(texto_lower.split()) <= 3:
                _set_talking(True)
                key = cache.play_random_and_wait("interrupcion", 4, FRASES_INTERRUPCION)
                print(f"\n🤖 [{key}]\n")
                _set_talking(False)
                continue

            # Goodbye → sleep
            if texto_lower in ["chao", "adiós", "adios", "salir", "terminar", "hasta luego"]:
                _set_talking(True)
                key = cache.play_random_and_wait("despedida", 3, DESPEDIDAS)
                print(f"\n🤖 [{key}]\n")
                _set_talking(False)
                print("💤 Volviendo a dormir... Di 'Orbit' cuando quieras.\n")
                dormido = True
                continue

            if texto_lower in ["silencio", "silenciar"]:
                bot.voz.silenciar()
                print("🔇 Voz silenciada")
                continue

            if texto_lower in ["hablar", "voz", "activar"]:
                bot.voz.activar()
                print("🔊 Voz activada")
                _set_talking(True)
                cache.play_and_wait("interrupcion_1", "¡Aquí estoy!")  # "¡Aquí estoy!"
                _set_talking(False)
                continue

            # ── Normal LLM response with interrupt watcher ────────────────
            print(f"\n👤 Dijiste: '{texto}'")
            t1 = time.time()
            resp = bot.responder(texto)
            t2 = time.time() - t1

            u           = bot.agente.last_usage
            session_tok = bot.agente.total_in + bot.agente.total_out
            if u:
                tok_str = f" | in:{u['in']} out:{u['out']} tok:{u['total']}"
                ses_str = f" | sesion: {session_tok:,} tok"
            else:
                tok_str = ses_str = ""
            print(f"⏱️  {t2:.2f}s{tok_str}{ses_str}")
            print(f"🤖 {resp}\n")

            _set_talking(True)
            bot.voz.hablar(resp)   # LLM response: still uses TTS

            # Interrupt watcher
            evento_interrupcion = threading.Event()
            evento_parar        = threading.Event()
            hilo = threading.Thread(
                target=_vigilar_interrupcion,
                args=(bot, evento_interrupcion, evento_parar),
                daemon=True,
            )
            hilo.start()

            bot.voz.esperar()
            evento_parar.set()
            hilo.join(timeout=1.5)
            _set_talking(False)

            if evento_interrupcion.is_set():
                _set_talking(True)
                key = cache.play_random_and_wait("interrupcion", 4, FRASES_INTERRUPCION)
                print(f"\n🤖 [{key}]\n")
                _set_talking(False)

            time.sleep(0.05)

        except Exception as e:
            print(f"[BOT] Error inesperado: {e}", file=sys.stderr)
            time.sleep(0.5)



# =============================================================================
# 📷 CAMERA LOOP  (main thread)
# =============================================================================
def camera_loop(bot_ref, bot_state: dict, state_lock: threading.Lock):
    """
    Runs face detection + motor tracking on the main thread.
    When the bot is speaking, motors hold still.
    """
    mp_face        = mp.solutions.face_detection
    face_detection = mp_face.FaceDetection(
        model_selection=0, min_detection_confidence=0.5
    )

    cap = cv2.VideoCapture(CAMERA_INDEX)
    if not cap.isOpened():
        print(f"[CAM] Cannot open camera {CAMERA_INDEX}. Trying index 1...")
        cap = cv2.VideoCapture(1)
        if not cap.isOpened():
            print("[CAM] No cameras found. Exiting camera loop.")
            return

    cap.set(cv2.CAP_PROP_FRAME_WIDTH,  640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

    smoother       = SmoothedBox(alpha=0.3)
    last_face_rect = None
    last_seen_time = 0.0

    # ── Face greeting / activation state ─────────────────────────────────────
    GREETING_TRIGGER_DELAY  = 2.0   # seconds face visible → play hint greeting (name mode)
    ACTIVATION_TRIGGER_DELAY = 4.0  # seconds face visible → start full bot cycle (face mode)
    GREETING_COOLDOWN        = 20.0 # seconds between any trigger (both modes)
    FRASES_BIENVENIDA = [
        "¡Hola! Soy Orbit. Si quieres saber algo sobre Venezuela y su cultura, solo di mi nombre.",
        "¡Hola! Me llamo Orbit. ¿Quieres conocer Venezuela? Solo llámame diciendo Orbit.",
        "¡Bienvenido! Soy Orbit, tu guía de Venezuela. Cuando quieras aprender algo, solo di Orbit.",
        "¡Hola! Soy Orbit. Conozco todo sobre Venezuela: su comida, música, historia y más. ¡Solo dí mi nombre!",
    ]
    face_first_seen   = None
    last_greeting_at  = 0.0
    greeting_cache    = AudioCache(bot_ref.voz)

    print("\n[CAM] Face tracker running. Press 'q' to quit, 'f' to toggle face-activation mode.\n")

    while True:
        ret, frame = cap.read()
        if not ret:
            time.sleep(0.05)
            continue

        h_frame, w_frame, _ = frame.shape
        cam_cx = w_frame // 2

        # Centre zone markers
        zone_w      = int(w_frame * CENTER_ZONE_FRACTION)
        left_line   = cam_cx - zone_w // 2
        right_line  = cam_cx + zone_w // 2

        marker_color = (255, 100, 0)
        cv2.line(frame, (left_line,  0), (left_line,  h_frame), marker_color, 2)
        cv2.line(frame, (right_line, 0), (right_line, h_frame), marker_color, 2)

        # ── Read shared bot state ─────────────────────────────────────────
        with state_lock:
            bot_talking          = bot_state["talking"]
            bot_active           = bot_state["active"]
            face_activation_mode = bot_state.get("face_activation_mode", False)

        # ── Face detection ────────────────────────────────────────────────
        rgb_frame     = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        results       = face_detection.process(rgb_frame)
        now           = time.time()
        face_detected = False

        if results.detections:
            largest = max(
                results.detections,
                key=lambda d: d.location_data.relative_bounding_box.width
                              * d.location_data.relative_bounding_box.height,
            )
            bbox = largest.location_data.relative_bounding_box
            x = int(bbox.xmin  * w_frame)
            y = int(bbox.ymin  * h_frame)
            w = int(bbox.width * w_frame)
            h = int(bbox.height * h_frame)

            x, y, w, h    = smoother.update((x, y, w, h))
            face_detected  = True
            last_face_rect = (x, y, w, h)
            last_seen_time = now

            draw_hitbox(frame, x, y, w, h, "LOCKED")

            face_cx = x + w // 2

            if bot_talking:
                # Motors hold while bot speaks to avoid noise
                send_motor_command("C")
                nav_text  = "[ BOT TALKING — MOTORS HOLD ]"
                nav_color = (0, 200, 255)
            elif face_cx < left_line:
                nav_text  = "<< MOVE CAMERA LEFT"
                nav_color = (0, 0, 255)
                send_motor_command("L")
            elif face_cx > right_line:
                nav_text  = "MOVE CAMERA RIGHT >>"
                nav_color = (0, 0, 255)
                send_motor_command("R")
            else:
                nav_text  = "[ ALIGNED IN CENTER ]"
                nav_color = (0, 255, 0)
                send_motor_command("C")

            text_size = cv2.getTextSize(nav_text, cv2.FONT_HERSHEY_SIMPLEX, 0.8, 2)[0]
            text_x    = cam_cx - text_size[0] // 2
            cv2.putText(frame, nav_text, (text_x, h_frame - 40),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.8, nav_color, 2)

            # ── Face trigger (greeting or full activation) ────────────────
            if face_first_seen is None:
                face_first_seen = now

            face_visible_for = now - face_first_seen
            cooldown_ok      = (now - last_greeting_at) > GREETING_COOLDOWN
            bot_vacant       = not bot_active and not bot_talking

            # Pick which delay applies to the current mode
            current_delay = ACTIVATION_TRIGGER_DELAY if face_activation_mode else GREETING_TRIGGER_DELAY

            # Progress bar (bottom of frame) while counting down
            if bot_vacant and face_visible_for < current_delay:
                progress  = face_visible_for / current_delay
                bar_w     = int((w_frame - 20) * progress)
                bar_color = (0, 200, 255) if face_activation_mode else (0, 180, 80)
                cv2.rectangle(frame, (10, h_frame - 20), (10 + bar_w, h_frame - 10), bar_color, -1)
                cv2.rectangle(frame, (10, h_frame - 20), (w_frame - 10, h_frame - 10), (80, 80, 80), 1)

            if face_visible_for >= current_delay and cooldown_ok and bot_vacant:
                last_greeting_at = now
                face_first_seen  = now  # reset streak timer

                if face_activation_mode:
                    # ── Face mode: trigger full bot cycle ─────────────────
                    print("[CAM] Face activation → waking bot loop")
                    with state_lock:
                        bot_state["face_wake"] = True
                else:
                    # ── Name mode: play the hint greeting only ────────────
                    idx = random.randrange(4)
                    key = f"bienvenida_{idx}"
                    print(f"[CAM] Greeting → {key}")
                    with state_lock:
                        bot_state["talking"] = True
                    def _play_greeting(k, fb):
                        greeting_cache.play_and_wait(k, fb)
                        with state_lock:
                            bot_state["talking"] = False
                    threading.Thread(
                        target=_play_greeting,
                        args=(key, FRASES_BIENVENIDA[idx]),
                        daemon=True,
                    ).start()

        else:
            send_motor_command("C")
            face_first_seen = None  # reset streak when face disappears
            if last_face_rect is not None:
                x, y, w, h = last_face_rect
                draw_hitbox(frame, x, y, w, h, "SEARCHING")
                if now - last_seen_time > 0.6:
                    last_face_rect     = None
                    smoother.prev_box  = None

        # ── HUD overlay ───────────────────────────────────────────────────
        cv2.rectangle(frame, (0, 0), (w_frame, 60), (0, 0, 0), -1)

        # Row 1 — bot status
        if bot_active or bot_talking:
            hud_color = (0, 255, 255) if bot_talking else (0, 200, 100)
            hud_text  = "BOT TALKING..." if bot_talking else "BOT ACTIVE"
            cv2.putText(frame, hud_text, (10, 22),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.75, hud_color, 2)
        else:
            cv2.putText(frame, "Say 'ORBIT' to activate",
                        (10, 22), cv2.FONT_HERSHEY_SIMPLEX, 0.65, (120, 120, 120), 1)

        # Row 2 — face activation mode toggle [F] key
        mode_label = "FACE ACTIVATION: ON" if face_activation_mode else "FACE ACTIVATION: OFF"
        mode_color = (0, 220, 255)          if face_activation_mode else (100, 100, 100)
        cv2.putText(frame, f"[F] {mode_label}", (10, 50),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.55, mode_color, 1)

        # Face detection status (top-right)
        status_text  = "FACE DETECTED" if face_detected else "SCANNING..."
        status_color = (0, 255, 0)    if face_detected else (0, 255, 255)
        cv2.putText(frame, status_text, (w_frame - 220, 22),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, status_color, 2)
        cv2.putText(frame, "Q: quit", (w_frame - 100, 50),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, (160, 160, 160), 1)

        cv2.imshow("Orbit Robot", frame)

        key_pressed = cv2.waitKey(1) & 0xFF
        if key_pressed == ord("q"):
            break
        elif key_pressed in (ord("f"), ord("F")):
            with state_lock:
                cur = bot_state.get("face_activation_mode", False)
                bot_state["face_activation_mode"] = not cur
            print(f"[CAM] Face activation mode: {'ON' if not cur else 'OFF'}")

    # ── Cleanup ───────────────────────────────────────────────────────────────
    send_motor_command("C")
    if mega_board:
        mega_board.close()
    cap.release()
    cv2.destroyAllWindows()
    face_detection.close()


# =============================================================================
# 🚀 MAIN
# =============================================================================
def main():
    print("=" * 60)
    print("🤖  ORBIT ROBOT — Face Tracker + Venezuela Bot  🇻🇪")
    print("=" * 60 + "\n")

    # Shared state between camera and bot threads
    bot_state  = {
        "talking":              False,
        "active":               False,
        "face_wake":            False,   # camera sets this to trigger bot activation
        "face_activation_mode": False,   # toggle with [F] key in camera window
    }
    state_lock = threading.Lock()

    # Build bot (calibrates mic — do before launching threads)
    print("Initialising bot...")
    bot = Embajador()
    start_sync()   # start background thread polling custom questions from cloud
    print(f"  IA: {bot.cfg.proveedor} · {bot.cfg.modelo}")
    print(f"  🎤 Micrófono: {'✅ Listo' if bot.oidos.disponible else '❌ No disponible'}")
    print(f"  Preguntas base: {len(PREGUNTAS)}")
    print("=" * 60 + "\n")

    if not bot.oidos.disponible:
        print("❌ No se detectó micrófono. Bot deshabilitado — solo modo cámara.")
        camera_loop(bot, bot_state, state_lock)
        return

    # Launch bot on a background daemon thread
    bot_thread = threading.Thread(
        target=bot_loop,
        args=(bot, bot_state, state_lock),
        daemon=True,
        name="BotThread",
    )
    bot_thread.start()

    # Camera loop on main thread (required on macOS/Linux for GUI windows)
    camera_loop(bot, bot_state, state_lock)

    print("\n👋 Saliendo...\n")


if __name__ == "__main__":
    main()
