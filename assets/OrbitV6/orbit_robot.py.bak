CAMERA_INDEX   = 0      # Try 1 if 0 fails
SERIAL_PORT    = "/dev/ttyUSB0"   # Change to /dev/ttyACM0 if needed
SERIAL_BAUD    = 115200

CENTER_ZONE_FRACTION = 0.25   # Fraction of frame width considered "centred"

AUDIO_CACHE_DIR = os.path.join(_SCRIPT_DIR, "audio_cache")


# =============================================================================
# 🔊 AUDIO CACHE — instant playback of pre-generated MP3s
# =============================================================================
try:
    import pygame
    pygame.mixer.init(frequency=22050, size=-16, channels=2, buffer=512)
    _PYGAME_OK = True
except Exception as _pg_err:
    _PYGAME_OK = False
    print(f"[AudioCache] pygame unavailable ({_pg_err}), will fall back to TTS.")


class AudioCache:
    """
    Plays pre-generated MP3 files instantly via pygame.
    Falls back silently to the bot's normal TTS if a file doesn't exist.

    Usage:
        cache = AudioCache(bot.voz)
        cache.play("saludo_0")           # instant
        cache.play_random("saludo", 4)   # random from saludo_0..saludo_3
        cache.wait()                     # block until playback done
    """

    def __init__(self, voz):
        self._voz      = voz          # Voz instance for fallback TTS
        self._playing  = False
        self._lock     = threading.Lock()

    def _path(self, key: str) -> str:
        return os.path.join(AUDIO_CACHE_DIR, f"{key}.mp3")

    def play(self, key: str, fallback_text: str = "") -> bool:
        """Play cached file. Returns True if cache hit, False if fell back to TTS."""
        path = self._path(key)
        if _PYGAME_OK and os.path.isfile(path):
            def _run():
                with self._lock:
                    try:
                        pygame.mixer.music.load(path)
                        pygame.mixer.music.play()
                        self._playing = True
                        while pygame.mixer.music.get_busy():
                            time.sleep(0.05)
                    except Exception as e:
                        print(f"[AudioCache] pygame error: {e}")
                    finally:
                        self._playing = False
            threading.Thread(target=_run, daemon=True).start()
            return True
        else:
            # Fallback: use the normal TTS engine
            if fallback_text:
                self._voz.hablar(fallback_text)
            return False

    def play_random(self, prefix: str, count: int, fallback_list=None) -> str:
        """Pick a random index 0..count-1, play it, return the chosen key."""
        idx = random.randrange(count)
        key = f"{prefix}_{idx}"
        fb  = fallback_list[idx] if fallback_list else ""
        self.play(key, fb)
        return key

    def wait(self):
        """Block until cached playback finishes (or falls through instantly if TTS)."""
        if _PYGAME_OK:
            while pygame.mixer.music.get_busy():
                time.sleep(0.05)
        else:
            self._voz.esperar()

    def play_and_wait(self, key: str, fallback_text: str = ""):
        self.play(key, fallback_text)
        self.wait()

    def play_random_and_wait(self, prefix: str, count: int, fallback_list=None) -> str:
        key = self.play_random(prefix, count, fallback_list)
        self.wait()
        return key


